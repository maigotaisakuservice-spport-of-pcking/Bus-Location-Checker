rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the current user is an authenticated administrator
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      // Admin creation should be done via Firebase Console or a separate secure process
      // to avoid exposing secrets in client-side code.
      // For initial setup, we allow the first admin if the collection is empty (optional)
      // but for production, recommend manual console entry.
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && request.auth.uid == adminId;
    }

    // Buses collection: Stores real-time location, metadata, and route geometry
    match /buses/{busId} {
      allow read: if request.auth != null;
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow create, delete: if isAdmin();
    }

    // Bus Stops collection
    match /busStops/{stopId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Users collection: Tracks parent logins with registration year
    match /users/{userId} {
      allow create: if request.resource.data.busId != null;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // WebRTC Signaling collection
    match /signaling/{docId} {
      allow read, write: if request.auth != null;
    }

    // FCM Tokens for Push Notifications
    match /fcmTokens/{tokenId} {
      // Authenticated users can create/update their own tokens
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }

    // Global Config and Emergency Messages
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}

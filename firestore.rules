rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the current user is an authenticated administrator via Firebase Auth
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection
    match /admins/{adminId} {
      // Allow read for passkey lookup in demo environment
      allow get: if true;
      allow list: if true;

      allow create: if isAdmin();
      allow update, delete: if isAdmin() && request.auth.uid == adminId;
    }

    // Buses collection
    match /buses/{busId} {
      allow read: if true;
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow create, delete: if isAdmin();
    }

    match /busStops/{stopId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{docId} {
      allow create: if request.resource.data.busId != null;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    match /users_meta/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if true;
    }

    match /signaling/{docId} {
      allow read, write: if true;
    }

    match /fcmTokens/{tokenId} {
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if true;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

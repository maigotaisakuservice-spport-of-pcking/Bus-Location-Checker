rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the current user is an authenticated administrator via Firebase Auth.
    // This is the standard, secure way to check permissions.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins collection
    match /admins/{adminId} {
      // Allow 'get' for everyone to support the client-side Passkey shim (demo purpose).
      // Allow 'list' for everyone so the Passkey login can search for the matching credentialId.
      // PRODUCTION WARNING: In a real production environment, this lookup and verification
      // should be handled by a secure backend (e.g., Cloud Functions) which returns
      // a Firebase Custom Token via signInWithCustomToken.
      allow read: if true;

      allow create: if isAdmin();
      allow update, delete: if isAdmin() && request.auth.uid == adminId;
    }

    // Buses collection: Stores real-time location, metadata, and route geometry
    match /buses/{busId} {
      // Allow read for everyone for the demo/shim.
      // Security is still maintained via client-side E2EE (End-to-End Encryption).
      // Without the encryption key, the data remains undecipherable.
      allow read: if true;
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow create, delete: if isAdmin();
    }

    // Bus Stops collection
    match /busStops/{stopId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection: Tracks parent logins
    match /users/{docId} {
      allow create: if request.resource.data.busId != null;
      allow read: if true; // Relaxed for admin panel view during passkey demo
      allow update, delete: if isAdmin();
    }

    // User Metadata collection
    match /users_meta/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow admin to read for management
      allow read: if true;
    }

    // WebRTC Signaling collection
    match /signaling/{docId} {
      allow read, write: if true;
    }

    // FCM Tokens for Push Notifications
    match /fcmTokens/{tokenId} {
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if true;
    }

    // Global Config and Emergency Messages
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

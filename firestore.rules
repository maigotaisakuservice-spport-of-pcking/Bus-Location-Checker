rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin checks
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins can read and write all system data
    match /admins/{adminId} {
      allow read, write: if request.auth != null && (request.auth.uid == adminId || isAdmin());
    }

    match /buses/{busId} {
      // Authenticated users (parents/admins) can read bus info
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /busStops/{stopId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /signaling/{docId} {
      // Signaling is for P2P connection between sender and user
      allow read, write: if request.auth != null;
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // User metadata and personal settings
    match /users_meta/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /users/{docId} {
      // Access to the collection mapping Google UIDs to encryption profiles
      allow read: if request.auth != null;
      allow write: if isAdmin();
      // Allow registration of the user's own profile
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}

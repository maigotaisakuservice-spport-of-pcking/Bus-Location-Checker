<?xml version='1.0' encoding='utf-8'?>
<widget id="jp.bus.location.sender" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>バス送信</name>
    <description>
        バス位置情報をFirestoreに送信するための送信者専用アプリです。
    </description>
    <author email="dev@example.com" href="http://example.com">
        Bus Tracking Dev
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="AndroidPersistentFileLocation" value="Internal" />
        <preference name="KeepRunning" value="true" />
    </platform>
    <plugin name="cordova-plugin-geolocation" spec="^4.1.0">
        <variable name="GEOLOCATION_USAGE_DESCRIPTION" value="バスの現在地を送信するために位置情報を使用します。" />
    </plugin>
    <plugin name="cordova-plugin-background-mode" spec="^0.7.3" />
    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />
    <preference name="ScrollEnabled" value="false" />
    <preference name="BackupWebStorage" value="none" />
</widget>
